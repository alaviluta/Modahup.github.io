document.addEventListener("DOMContentLoaded", () => {

    // ==========================================
    // 0. CORRECCIÓN Y REVISIÓN DE RUTAS DE IMÁGENES
    // ==========================================
    const todasLasImagenes = document.querySelectorAll("img");
    todasLasImagenes.forEach(img => {
        img.addEventListener("error", function () {
            let nombreArchivo = this.src.split('/').pop();
            // Intento 1: Buscar directamente en la carpeta raíz
            if (!this.dataset.intento) {
                this.dataset.intento = "1";
                this.src = "./" + nombreArchivo;
            }
            // Intento 2: Buscar dentro de la carpeta /imagenes/
            else if (this.dataset.intento === "1") {
                this.dataset.intento = "2";
                this.src = "./imagenes/" + nombreArchivo;
            }
            // Si no existe, colocar imagen base de reemplazo
            else {
                this.src = "https://via.placeholder.com/300x200?text=Imagen+no+encontrada";
            }
        });
    });

    // ==========================================
    // 1. ALERTA AL CARGAR LA PÁGINA
    // ==========================================
    alert("¡Bienvenido a ModaHub! Explora nuestras tiendas, cursos y novedades.");

    // ==========================================
    // 3. FECHA Y HORA EN TIEMPO REAL
    // ==========================================
    const headerContainer = document.querySelector(".header-container");
    if (headerContainer) {
        const cajaReloj = document.createElement("div");
        cajaReloj.className = "reloj-box";
        cajaReloj.id = "reloj-envivo";
        headerContainer.appendChild(cajaReloj);

        function actualizarTiempo() {
            const horaActual = new Date();
            cajaReloj.textContent = horaActual.toLocaleString("es-AR");
        }
        setInterval(actualizarTiempo, 1000);
        actualizarTiempo();
    }

    // ==========================================
    // 6. MODO OSCURO (TOGGLE)
    // ==========================================
    const navMenu = document.querySelector(".nav-menu");
    if (navMenu) {
        const botonModo = document.createElement("button");
        botonModo.textContent = "🌙 Modo Oscuro";
        botonModo.style.cssText = "cursor:pointer; padding: 6px 12px; border-radius: 4px; border: none; background: #333; color: #fff;";
        
        botonModo.addEventListener("click", () => {
            document.body.classList.toggle("modo-oscuro");
            const esOscuro = document.body.classList.contains("modo-oscuro");
            botonModo.textContent = esOscuro ? "☀️ Modo Claro" : "🌙 Modo Oscuro";
            botonModo.style.background = esOscuro ? "#fff" : "#333";
            botonModo.style.color = esOscuro ? "#000" : "#fff";
        });
        navMenu.appendChild(botonModo);
    }

    // ==========================================
    // 4. MENÚS INTERACTIVOS (ACORDEÓN)
    // ==========================================
    const titulosAcordeon = document.querySelectorAll(".acordeon-titulo");
    titulosAcordeon.forEach(btn => {
        btn.addEventListener("click", () => {
            const contenido = btn.nextElementSibling;
            if (contenido && contenido.classList.contains("acordeon-contenido")) {
                contenido.classList.toggle("activo");
            }
        });
    });

    // ==========================================
    // 5. GALERÍA DE IMÁGENES Y AMPLIACIÓN EN MODAL
    // ==========================================
    const listaImagenes = [
        "./imagenes/nike.png",
        "./imagenes/adidas.png",
        "./imagenes/buzo.png",
        "./imagenes/outfit.png",
        "./imagenes/pantalon.png",
        "./imagenes/remera.png",
        "./imagenes/moda.png",
        "./imagenes/moda2.png",
        "./imagenes/oferta.png"
    ];
    let posGaleria = 0;
    const imgVisorGaleria = document.getElementById("galeria-principal");
    const btnAnt = document.getElementById("btn-anterior");
    const btnSig = document.getElementById("btn-siguiente");

    if (imgVisorGaleria && btnAnt && btnSig) {
        btnAnt.addEventListener("click", () => {
            posGaleria = (posGaleria - 1 + listaImagenes.length) % listaImagenes.length;
            imgVisorGaleria.src = listaImagenes[posGaleria];
        });

        btnSig.addEventListener("click", () => {
            posGaleria = (posGaleria + 1) % listaImagenes.length;
            imgVisorGaleria.src = listaImagenes[posGaleria];
        });
    }

    // Modal para ampliar imágenes al hacer clic
    const modalVentana = document.createElement("div");
    modalVentana.className = "modal-visor";
    modalVentana.innerHTML = `
        <img id="imagen-modal-ampliada" src="" alt="Imagen Ampliada">
        <span id="cerrar-modal-btn" style="position:absolute; top:20px; right:35px; color:#fff; font-size:40px; cursor:pointer;">&times;</span>
    `;
    document.body.appendChild(modalVentana);

    const imagenesAmpliables = document.querySelectorAll("img");
    imagenesAmpliables.forEach(imagen => {
        imagen.addEventListener("click", () => {
            if (imagen.id !== "imagen-modal-ampliada") {
                document.getElementById("imagen-modal-ampliada").src = imagen.src;
                modalVentana.style.display = "flex";
            }
        });
    });

    document.getElementById("cerrar-modal-btn").addEventListener("click", () => {
        modalVentana.style.display = "none";
    });

    // ==========================================
    // 2 Y 7. VALIDACIÓN DE FORMULARIO Y RESUMEN
    // ==========================================
    const formulario = document.querySelector("form");
    if (formulario) {
        formulario.addEventListener("submit", (evento) => {
            evento.preventDefault();
            let formularioValido = true;

            // Limpiar alertas de error previas
            document.querySelectorAll(".mensaje-error").forEach(error => error.remove());

            // 1. Validar campos no vacíos
            const camposRequeridos = formulario.querySelectorAll("[required]");
            camposRequeridos.forEach(campo => {
                if (!campo.value.trim()) {
                    mostrarMensajeError(campo, "Este campo no puede estar vacío.");
                    formularioValido = false;
                }
            });

            // 2. Validar correo electrónico
            const campoEmail = formulario.querySelector('input[type="email"]');
            if (campoEmail && campoEmail.value.trim() !== "") {
                const patronEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!patronEmail.test(campoEmail.value.trim())) {
                    mostrarMensajeError(campoEmail, "Por favor ingrese un correo válido (ejemplo@dominio.com).");
                    formularioValido = false;
                }
            }

            // 3. Resumen previo a enviar
            if (formularioValido) {
                const datosFormulario = new FormData(formulario);
                let resumenTexto = "=== RESUMEN DE DATOS ===\n\n";

                datosFormulario.forEach((valor, clave) => {
                    resumenTexto += `${clave.toUpperCase()}: ${valor}\n`;
                });

                const confirmacion = confirm(resumenTexto + "\n¿Los datos son correctos? Presione Aceptar para enviar.");
                if (confirmacion) {
                    alert("¡Formulario enviado con éxito!");
                    formulario.reset();
                }
            }
        });
    }

    function mostrarMensajeError(elemento, mensaje) {
        const textoError = document.createElement("span");
        textoError.className = "mensaje-error";
        textoError.textContent = mensaje;
        elemento.parentNode.insertBefore(textoError, elemento.nextSibling);
    }
});
